# Salin ke /opt/airflow/repo/.env di server lalu isi nilainya.
# Jangan commit file .env (sudah masuk .gitignore).

# --- MariaDB tujuan ETL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- SIAKAD v2 / AS400 (DAG siakad_v2_mahasiswa_ir_irfan) ---
SIAKAD_LAMA_URL="http://192.168.4.30/siakad_api/api/as400"
# Token dari POST {SIAKAD_LAMA_URL}/signin (form-data: username, password),
# ambil nilai field "Authorization" di responsnya. Perbarui di sini bila kedaluwarsa.
TOKEN_SIAKAD_LAMA=""

# --- SIMTA (DAG simta_mahasiswa) ---
# Alamat dasar API, tanpa garis miring di akhir.
SIMTA_API_URL=https://simta.unj.ac.id/api/etl
# Token lengkap dari `php artisan etl:token`, termasuk id di depan (mis. "33|...").
# Kalau bocor/kedaluwarsa: `php artisan etl:cabut-token <id>`, buat baru, ganti di sini.
SIMTA_API_TOKEN=
# Harus sesuai prodi yang diizinkan token. Beberapa prodi: 15136,15137
SIMTA_KODE_PRODI=15136
# Opsional, baris per halaman (maks 1000). Default 100.
SIMTA_PER_PAGE=100

